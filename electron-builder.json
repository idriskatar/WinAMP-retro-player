{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.idriskatar.winamp-retro-player",
  "productName": "WinAMP Retro Player",
  "copyright": "Copyright © 2026 Idris Katar",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist",
    "electron",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WinAMP Retro Player"
  },
  "mac": {
    "target": [
      {
        "target": "dmg"
      },
      {
        "target": "zip"
      }
    ],
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "category": "public.app-category.music",
    "icon": "public/icon.icns"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "AudioVideo",
    "icon": "public/icon.png"
  }
}
