{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.idriskatar.winamp-retro-player",
  "productName": "WinAMP Retro Player",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "electron",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "build/icon.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "WinAMP Retro Player"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "category": "public.app-category.music",
    "icon": "build/icon.icns"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "maintainer": "Idris Katar <idriskatar@gmail.com>",
    "category": "AudioVideo",
    "icon": "build/icon.png"
  }
}
